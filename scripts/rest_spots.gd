class_name RestSpots
extends RefCounted
## Где на мебели сидят и лежат: точки в осях самой модели (как в наборах мебели: +z — лицо, клетка 1×1).
## Нужны, чтобы человек садился точно на сиденье и ложился головой на подушку, а не «примерно в клетку».
## "k": 1 — сидеть, 2 — лежать; "p".y — высота сиденья или постели над полом.
## Сидеть: "p" (x, z) — куда приходит таз. "gap" — стоять перед сиденьем на столько дальше; "fx", "fy", "fz" —
## подножки: полрасстояния между стопами, высота над полом, на сколько впереди таза.
## Лежать: голова — в сторону −x модели. "p" (x, z) — опорная точка: где начинается подъём изголовья ("bend" 1 —
## тело сгибается в пояснице, 2 — в груди; "raise" — угол подъёма), а у ровной постели ("bend" 0) — середина
## подушки. "pillow" — на сколько приподнять голову (подбирается по модели: test_rest_poses); "feet" — на сколько приподняты стопы (лежат на сложенном одеяле);
## "sides" — с какой стороны подходят (1 — с лица, −1 — сзади); "deep" — на сколько середина постели дальше
## места, где человек стоял; "room" — сколько места от опорной точки до спинки в ногах; "low" 1 — над постелью
## верхний ярус (ложатся пригнувшись); "climb" и "rungs" — лесенка на верхний ярус: где стоит и высоты перекладин.
## Меняешь модель мебели — поправь её точки здесь (проверка test_rest_poses сверяет их с моделью).

const W = preload("res://scripts/world.gd")

## mode — как стоит мебель: 1 — одна клетка, 2 — длинная на две клетки, 3 — койка изголовьем к стене;
## hv — «случайное число» клетки (от него зависят мелочи модели: сложенное одеяло на нарах)
static func local(t: int, mode: int, hv: int = 0) -> Array:
	var wide := mode == 2
	match t:
		W.BUNK:
			if wide:
				# нижний ярус — пригнувшись под верхний; верхний — по лесенке ("climb" — где она стоит, "rungs" — перекладины)
				return [{"k": 2, "p": Vector3(-0.29, 0.5, 0), "sides": [1], "deep": 0.62, "bend": 0, "pillow": 0.065, "room": 1.7, "feet": 0.02, "low": 1},
					{"k": 2, "p": Vector3(-0.29, 1.32, 0), "sides": [1], "deep": 0.62, "bend": 0, "pillow": 0.065, "room": 1.7, "feet": 0.02,
						"climb": Vector3(1.25, 0, 0.455), "rungs": [0.3, 0.64, 0.98]}]
		W.CHAIR:
			return [{"k": 1, "p": Vector3(-0.245, 0.48, -0.04)}, {"k": 1, "p": Vector3(0.245, 0.48, -0.04)}]
		W.BENCH:
			return [{"k": 1, "p": Vector3(-0.25, 0.4675, -0.02)}, {"k": 1, "p": Vector3(0.25, 0.4675, -0.02)}]
		W.OFFICECHAIR:
			return [{"k": 1, "p": Vector3(0, 0.555, 0.0)}]
		W.SOFA:
			if wide:
				return [{"k": 1, "p": Vector3(0.12, 0.46, 0.06)}, {"k": 1, "p": Vector3(0.88, 0.46, 0.06)}]
			return [{"k": 1, "p": Vector3(0, 0.46, 0.06)}]
		W.WHEELCHAIR:
			return [{"k": 1, "p": Vector3(0, 0.515, -0.07), "gap": 0.2, "fx": 0.126, "fy": 0.14, "fz": 0.45}]
		W.CELLBUNK:
			if wide:
				return [{"k": 2, "p": Vector3(-0.23, 0.545, -0.08), "sides": [1], "deep": 0.62, "bend": 0, "pillow": 0.05,
					"feet": 0.07 if hv % 3 != 0 else 0.0}]
			return [{"k": 1, "p": Vector3(0, 0.545, 0.1)}]
		W.HOSPBED:
			if mode == 3:
				return [{"k": 2, "p": Vector3(-0.25, 0.715, 0), "sides": [1, -1], "deep": 0.72, "bend": 1, "raise": 24.0, "pillow": 0.005}]
			if wide:
				return [{"k": 2, "p": Vector3(0.17, 0.715, 0), "sides": [1], "deep": 0.72, "bend": 1, "raise": 24.0, "pillow": 0.005, "room": 1.25}]
			return [{"k": 1, "p": Vector3(0.15, 0.72, 0.12)}]
		W.GURNEY:
			if wide:
				return [{"k": 2, "p": Vector3(-0.25, 0.86, 0), "sides": [1, -1], "deep": 0.62, "bend": 0, "pillow": 0.055}]
		W.EXAMTABLE:
			if wide:
				return [{"k": 2, "p": Vector3(0.08, 0.705, 0), "sides": [1, -1], "deep": 0.6, "bend": 2, "raise": 20.0, "pillow": 0.055}]
			return [{"k": 1, "p": Vector3(0.1, 0.705, 0.1)}]
		W.OPTABLE:
			if wide:
				return [{"k": 2, "p": Vector3(-0.08, 0.815, 0), "sides": [-1, 1], "deep": 0.56, "bend": 2, "raise": 10.0}]
	return []
